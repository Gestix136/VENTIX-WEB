# ── Ventix Web — Variables de entorno ─────────────────────────
# Copia como .env para desarrollo local
# En Railway configura estas variables en el panel Environment

# OBLIGATORIO en producción
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar_por_clave_segura_en_produccion

# Base de datos
# Vacío = SQLite local (desarrollo)
# PostgreSQL en Railway:
# DATABASE_URL=postgresql://user:pass@host:5432/ventix
DATABASE_URL=

# Debug — SIEMPRE false en producción
FLASK_DEBUG=false

# Puerto (Railway lo asigna automáticamente)
PORT=5000
